{
  "name": "karboosx/procer",
  "type": "library",
  "description": "Custom language for writing business logic",
  "keywords": [
    "parser",
    "buisness logic",
    "procer"
  ],
  "homepage": "https://github.com/karboosx/procer",
  "license": "MIT",
  "authors": [
    {
      "name": "Michał Karbowiak",
      "email": "procer@karboosx.net",
      "homepage": "https://karboosx.net",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-ctype": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "Karboosx\\Procer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Karboosx\\Procer\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "@php -d error_reporting=32767 vendor/bin/phpunit",
    "test:stress": "@php -d error_reporting=32767 -d memory_limit=256M -d max_execution_time=120 vendor/bin/phpunit --group stress",
    "test:mutations": "@php tools/test-language-mutations.php",
    "test:docs": "@php tools/check-docs.php"
  }
}
